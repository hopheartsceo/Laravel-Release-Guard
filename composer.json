{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "hopheartsceo/laravel-release-guard",
    "description": "Detect database changes that can break the previous Laravel release during rolling and zero-downtime deployments.",
    "keywords": [
        "laravel",
        "deployment",
        "zero-downtime",
        "migrations",
        "static-analysis",
        "ci",
        "database"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ahmed Almabhoh",
            "email": "az540546@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/hopheartsceo/Laravel-Release-Guard/issues",
        "source": "https://github.com/hopheartsceo/Laravel-Release-Guard"
    },
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0",
        "symfony/process": "^6.2|^7.0|^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5"
    },
    "autoload": {
        "psr-4": {
            "Hopheartsceo\\ReleaseGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hopheartsceo\\ReleaseGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hopheartsceo\\ReleaseGuard\\ReleaseGuardServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "minimum-stability": "stable"
}
